---
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-white/[.08]">
  <div class="max-w-7xl mx-auto px-8 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex flex-col gap-1">
      <span class="italic font-black text-mt-white tracking-[.04em]">MOON TROPICA</span>
      <span class="font-mono text-xs text-mt-muted">A CAH Liquidity production · {year}</span>
    </div>
    <div class="flex items-center gap-4 text-sm text-mt-off-white">
      <a href="https://docs.moontropica.com/" target="_blank" rel="noopener" class="hover:text-mt-white">Litepaper</a>
      <a href="/blog" class="hover:text-mt-white">Blog</a>
    </div>
  </div>
</footer>
