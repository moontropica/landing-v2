---
const items = [
  { href: "/", label: "Home", external: false },
  { href: "/gallery.html", label: "Gallery", external: false },
  { href: "/branding.html", label: "Branding", external: false },
  { href: "/faq.html", label: "FAQ", external: false },
  { href: "/governance.html", label: "Governance", external: false },
  { href: "https://docs.moontropica.com/", label: "Litepaper", external: true },
  { href: "/blog", label: "Blog", external: false },
];
const path = Astro.url.pathname;
---

<nav class="flex items-center justify-between px-6 py-4 sticky top-0 z-50 bg-mt-ink-900/80 backdrop-blur-md border-b border-white/[.06]">
  <a href="/" class="block">
    <img src="/assets/Logo_Horizontal_White.png" alt="Moon Tropica" class="nav-logo h-[27px] w-auto block" />
  </a>
  <button id="hamburger" aria-label="Menu" class="hamburger-btn">
    <span></span><span></span><span></span>
  </button>
  <div id="navLinks" class="nav-links hidden absolute top-full left-0 right-0 flex-col bg-mt-ink-900/96 backdrop-blur-md border-b border-white/[.06] p-3 gap-1">
    {items.map((it) => {
      const active = path === it.href || (it.href !== "/" && path.startsWith(it.href));
      return (
        <a
          href={it.href}
          target={it.external ? "_blank" : undefined}
          rel={it.external ? "noopener" : undefined}
          class:list={[
            "no-underline italic font-black text-[13px] tracking-[.08em] uppercase py-2 px-4 rounded-pill transition-colors duration-100",
            active
              ? "text-mt-white bg-mt-purple-600/[.14]"
              : "text-mt-muted hover:text-mt-off-white hover:bg-white/5",
          ]}
        >
          {it.label}
        </a>
      );
    })}
    <div class="h-px bg-white/[.08] my-2"></div>
    <a href="https://store.steampowered.com/app/3664890/Moon_Tropica/" target="_blank" rel="noopener"
       class="nav-play block text-center no-underline bg-mt-gold-500 text-mt-ink-900 italic font-black text-[13px] tracking-[.08em] uppercase py-2.5 px-4 rounded-pill transition-colors duration-100 hover:bg-mt-gold-400">
      PLAY NOW ›
    </a>
  </div>
</nav>

<style>
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 8px;
  }
  .hamburger-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-mt-white);
    border-radius: 2px;
    transition: transform .2s, opacity .2s;
  }
  .hamburger-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger-btn.open span:nth-child(2) { opacity: 0; }
  .hamburger-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav-links.open { display: flex !important; }
  @media (min-width: 769px) {
    .nav-links { left: auto; right: 0; min-width: 220px; }
  }
</style>

<script>
  const hamburger = document.getElementById("hamburger");
  const navLinks = document.getElementById("navLinks");
  if (hamburger && navLinks) {
    hamburger.addEventListener("click", () => {
      hamburger.classList.toggle("open");
      navLinks.classList.toggle("open");
    });
  }
</script>
