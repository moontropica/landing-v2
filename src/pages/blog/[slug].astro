---
import { getCollection, render } from "astro:content";
import Base from "@layouts/Base.astro";
import { Badge } from "@components/ui/Badge.tsx";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const tagLabel: Record<string, string> = {
  "dev-updates": "Dev Updates",
  announcements: "Announcements",
  community: "Community",
  guides: "Guides",
};

const tagTone: Record<string, "gold" | "mint" | "coral" | "muted"> = {
  "dev-updates": "gold",
  announcements: "coral",
  community: "mint",
  guides: "muted",
};

const tags = post.data.tags ?? [];
const primaryTag = tags[0];
const label = primaryTag ? (tagLabel[primaryTag] ?? primaryTag) : null;

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const title = `${post.data.title} — Moon Tropica Blog`;
---

<Base title={title} description={post.data.description} image={post.data.image}>
  <div class="max-w-3xl mx-auto px-4 sm:px-0 mt-8 mb-6">
    <a href="/blog" class="inline-flex items-center gap-1.5 font-sans italic font-black text-[13px] tracking-[.08em] uppercase text-mt-muted hover:text-mt-white transition-colors duration-150 no-underline">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Back to Blog
    </a>
  </div>

  <article class="max-w-3xl mx-auto px-4 sm:px-0">
    {
      post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full rounded-r-lg mb-8"
          loading="eager"
        />
      )
    }

    <div class="flex flex-wrap items-center gap-4 mb-4">
      {label && <Badge tone={tagTone[primaryTag] ?? "muted"}>{label}</Badge>}
      <time class="font-mono text-xs text-mt-muted tracking-[.04em]" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
      </time>
      <span class="font-mono text-xs text-mt-muted tracking-[.04em]">{readingTime} min read</span>
    </div>

    <h1 class="italic font-black tracking-[-.02em] leading-[.95] text-[clamp(32px,5vw,56px)] [text-shadow:0_4px_0_var(--color-mt-purple-700),0_12px_40px_rgba(0,0,0,.35)] mb-6">
      {post.data.title}
    </h1>

    <p class="text-lg font-bold text-white/[.8] leading-relaxed mb-10">
      {post.data.description}
    </p>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-sans prose-headings:italic prose-headings:font-black prose-headings:tracking-[-.01em] prose-headings:text-mt-off-white
      prose-h2:text-[clamp(22px,2.5vw,30px)] prose-h2:mt-12 prose-h2:mb-4
      prose-p:font-semibold prose-p:text-[15px] prose-p:leading-relaxed prose-p:text-white/[.88]
      prose-strong:text-mt-white prose-strong:font-black
      prose-li:font-semibold prose-li:text-[15px] prose-li:leading-relaxed prose-li:text-white/[.88]
      prose-li:marker:text-mt-purple-400
      prose-a:text-mt-gold-300 prose-a:no-underline hover:prose-a:underline
      prose-code:font-mono prose-code:text-mt-mint prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
      prose-hr:border-white/[.08]
    ">
      <Content />
    </div>

    <hr class="border-white/[.08] my-10" />

    <div class="flex items-center gap-4">
      <span class="font-mono text-xs text-mt-muted tracking-[.12em] uppercase">Share</span>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`}
        target="_blank"
        rel="noopener"
        class="w-9 h-9 rounded-full bg-white/[.06] flex items-center justify-center text-mt-muted hover:bg-mt-purple-600 hover:text-mt-white transition-colors duration-150"
        aria-label="Share on X"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a
        href={`https://t.me/share/url?url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}&text=${encodeURIComponent(post.data.title)}`}
        target="_blank"
        rel="noopener"
        class="w-9 h-9 rounded-full bg-white/[.06] flex items-center justify-center text-mt-muted hover:bg-mt-purple-600 hover:text-mt-white transition-colors duration-150"
        aria-label="Share on Telegram"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
      <button
        class="w-9 h-9 rounded-full bg-white/[.06] flex items-center justify-center text-mt-muted hover:bg-mt-purple-600 hover:text-mt-white transition-colors duration-150 border-0 cursor-pointer"
        aria-label="Copy link"
        id="copy-link-btn"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    </div>

    <div class="mt-8">
      <a href="/blog" class="inline-flex items-center gap-1.5 font-sans italic font-black text-[13px] tracking-[.08em] uppercase text-mt-muted hover:text-mt-white transition-colors duration-150 no-underline">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to Blog
      </a>
    </div>
  </article>
</Base>

<script>
  const btn = document.getElementById("copy-link-btn");
  if (btn) {
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href);
      const svg = btn.querySelector("svg");
      if (svg) {
        const original = svg.innerHTML;
        svg.innerHTML = '<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>';
        btn.classList.add("!bg-mt-mint/15", "!text-mt-mint");
        setTimeout(() => {
          svg.innerHTML = original;
          btn.classList.remove("!bg-mt-mint/15", "!text-mt-mint");
        }, 1500);
      }
    });
  }
</script>
